# Shannon diversity 
# Violin/boxplot 

#!/usr/bin/env python

import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns


# directory and file
output_dir = "/pub60/kirsten/Projects/Results1/Section_2_diversity"

shannon_file = (
    f"{output_dir}/alpha_diversity_shannon_all.csv"
)


# read in the data
data = pd.read_csv(shannon_file)

data["shannon"] = pd.to_numeric(
    data["shannon"],
    errors="coerce"
)

data = data.dropna(
    subset=["shannon"]
)


cohort_order = [
    "PRJEB75460",
    "PRJEB75462",
    "PRJEB75463"
]


colours = {
    "PRJEB75460": "#2166AC",
    "PRJEB75462": "#4DAF4A",
    "PRJEB75463": "#B2182B"
}


# significance bracket
def add_significance_bar(
    ax,
    x1,
    x2,
    y,
    h,
    text
):

    ax.plot(
        [x1, x1, x2, x2],
        [y, y + h, y + h, y],
        lw=1.5,
        c="black"
    )

    ax.text(
        (x1 + x2) / 2,
        y + h,
        text,
        ha="center",
        va="bottom",
        fontsize=13,
        fontweight="bold"
    )


# plot
sns.set_style("whitegrid")

fig, ax = plt.subplots(
    figsize=(10, 8)
)


# violin plot
sns.violinplot(
    data=data,
    x="cohort",
    y="shannon",
    order=cohort_order,
    palette=colours,
    inner=None,
    cut=0,
    linewidth=1.2,
    saturation=0.8,
    ax=ax
)


# boxplot over violin
sns.boxplot(
    data=data,
    x="cohort",
    y="shannon",
    order=cohort_order,
    width=0.28,
    showfliers=False,
    boxprops={
        "facecolor": "white",
        "edgecolor": "black",
        "linewidth": 1.5,
        "zorder": 3
    },
    whiskerprops={
        "color": "black",
        "linewidth": 1.5,
        "zorder": 3
    },
    capprops={
        "color": "black",
        "linewidth": 1.5,
        "zorder": 3
    },
    medianprops={
        "color": "black",
        "linewidth": 1.5,
        "zorder": 4
    },
    ax=ax
)


# individual sample points
sns.stripplot(
    data=data,
    x="cohort",
    y="shannon",
    order=cohort_order,
    color="black",
    alpha=0.25,
    size=2,
    jitter=0.25,
    zorder=5,
    ax=ax
)


# significance min and max
y_min = data["shannon"].min()
y_max = data["shannon"].max()
y_range = y_max - y_min


# PRJEB75460 vs PRJEB75462
# Holm-adjusted p = 0.00328

add_significance_bar(
    ax=ax,
    x1=0,
    x2=1,
    y=y_max + y_range * 0.05,
    h=y_range * 0.015,
    text="**"
)


# PRJEB75460 vs PRJEB75463
# Holm-adjusted p = 3.25e-06

add_significance_bar(
    ax=ax,
    x1=0,
    x2=2,
    y=y_max + y_range * 0.15,
    h=y_range * 0.015,
    text="***"
)


# axis and title setting
ax.set_title(
    "Shannon diversity across cohorts",
    fontsize=16,
    fontweight="bold"
)

ax.set_xlabel(
    "Cohort",
    fontsize=13
)

ax.set_ylabel(
    "Shannon diversity",
    fontsize=13
)


# space for sig brackets
ax.set_ylim(
    y_min,
    y_max + y_range * 0.25
)


# save
plt.tight_layout()

png_file = (
    f"{output_dir}/"
    "shannon_diversity_violin_boxplot.png"
)

pdf_file = (
    f"{output_dir}/"
    "shannon_diversity_violin_boxplot.pdf"
)

plt.savefig(
    png_file,
    dpi=300,
    bbox_inches="tight"
)

plt.savefig(
    pdf_file,
    bbox_inches="tight"
)

plt.close()



print()
print("SHANNON VIOLIN + BOXPLOT COMPLETE")

print(f"Samples: {len(data)}")

for cohort in cohort_order:

    n = (
        data["cohort"] == cohort
    ).sum()

    print(
        f"{cohort}: n={n}"
    )

print()
print(f"PNG: {png_file}")
print(f"PDF: {pdf_file}")

print()
print("Significant comparisons:")
print("PRJEB75460 vs PRJEB75462: **")
print("PRJEB75460 vs PRJEB75463: ***")
print("PRJEB75462 vs PRJEB75463: not significant")



