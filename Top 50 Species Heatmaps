        f"bracken_genus_matrix_{cohort}.csv"
    )

    genus_matrix.to_csv(genus_file)

    print(f"Saved full genus matrix: {genus_file}")

    # Make heatmap

    make_heatmap(
        genus_matrix,
        cohort,
        "genera"
    )
