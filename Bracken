#!/bin/bash

for KREPORT in kraken2_results_newdb_62/*.kreport2; do
    # Loop through every Kraken2 taxonomic report for PRJEB75462


    SAMPLE=$(basename "$KREPORT" .kreport2)
    # extract sample name from the Kraken2 report filename

    if [ -f "Bracken_results_newdb_62/${SAMPLE}.bracken" ]; then
        echo "Skipping ${SAMPLE} - Bracken already completed"
        continue
    fi
    # If a Bracken output already exists for this sample, skip it
    # allows the script to be restarted if needed (issues with disk space)


    bracken \
        -d /pub60/kirsten/databases \
        -i "$KREPORT" \
        -o "Bracken_results_newdb_62/${SAMPLE}.bracken" \
        -w "Bracken_results_newdb_62/${SAMPLE}.breport" \
        -r 150 \
        -l S \
        -t 10
    # use same PlusPFP database used for Kraken2
    # -d = Kraken2 database
    # -i = Kraken2 .kreport2 input
    # -o = Bracken abundance output
    # -w = Bracken adjusted Kraken style report
    # -r 150 = read length = 150 bp
    # -l S = estimate abundance at species level
    # -t 10 = minimum read threshold for inclusion
done


